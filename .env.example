# Copy to .env and fill in. Never commit .env. Secrets and real phone numbers live only here and
# in the Supabase function secrets (`supabase secrets set NAME=...`); never print or paste them.
# Independent open-source project · not affiliated with any government body.

# Supabase (Project settings > API). The service role key is server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
# Phone numbers page, after importing the Twilio number into ElevenLabs
ELEVENLABS_PHONE_NUMBER_ID=
# Written by `deno task push-agents konza` when the agent is first created
AGENT_ID_KONZA=

# Twilio (one number, voice and SMS). Also a function secret.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Shared secret ElevenLabs sends in the x-tool-secret header (push-agents stores it in the
# ElevenLabs workspace). Long random string. Also a function secret.
TOOL_SECRET=
# Pepper for one-time code hashes. Long random string. Also a function secret.
OTP_PEPPER=
# Secret on the ElevenLabs post-call webhook (call_ended). Long random string. Also a function secret.
POSTCALL_SECRET=

# Konza API profile: member systems' secret, and the officer credential for decisions and desks.
# Long random strings. Also function secrets.
KONZA_CLIENT_SECRET=
KONZA_OFFICER_SECRET=

# The Mirror Vale Audit Office: the secret tools uses to call the audit function, and the audit
# function's own database connection as the role mirror_vale (transaction pooler URI, user
# mirror_vale.<project ref>). Function secrets; AUDIT_DB_URL here only to record sampled checks.
AUDIT_SECRET=
AUDIT_DB_URL=

# Web app URL, no trailing slash. Also a function secret.
WEB_BASE_URL=

# Your own phone (E.164). Every code and SMS goes to it. Only ever here.
DEMO_UK_MOBILE=
# Comma separated E.164 numbers that may receive SMS and code calls. Unset means nobody.
# Also a function secret.
ALLOWED_RECIPIENTS=
# Optional: SMS and code calls allowed in any 24 hours (default 100).
SMS_DAILY_BUDGET=

# Calendar email (Resend). Unset means no email is sent. Also function secrets.
RESEND_API_KEY=
# Comma separated addresses that may receive email. Unset means nobody.
ALLOWED_EMAIL_RECIPIENTS=
# Optional: emails allowed in any 24 hours (default 20).
EMAIL_DAILY_BUDGET=

# Panel sign-in: comma separated emails that may sign in to the panel. Also set on Vercel,
# with ELEVENLABS_API_KEY (server only, for the browser handset's signed URLs).
PANEL_EMAILS=

# Claude API: `deno task seed:gen` (synthetic residents) and `deno task audit sample` (sampled
# charter checks of redacted calls). Optional; both have a dry run that sends nothing.
ANTHROPIC_API_KEY=

# Local runs only, never on the deployed function: print SMS and code calls instead of sending.
# SMS_DRY_RUN=1
