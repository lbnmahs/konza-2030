# Copy to .env.local for local dev. On Vercel set each one as a project env var.
# Browser: the project URL and its anon key (never the service role key).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only, never prefixed with NEXT_PUBLIC_ (on Vercel mark them Sensitive).
# SUPABASE_SERVICE_ROLE_KEY and ELEVENLABS_API_KEY: the same values as in the repo root .env.
SUPABASE_SERVICE_ROLE_KEY=
ELEVENLABS_API_KEY=
# The tools function's UI_ACT_SECRET for screen taps (never TOOL_SECRET).
UI_ACT_SECRET=
# Comma-separated emails that may sign in to the panel.
PANEL_EMAILS=
