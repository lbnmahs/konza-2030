# Copy to .env.local for local dev. On Vercel set all three as project env vars.
# Browser vars: SUPABASE_URL and SUPABASE_ANON_KEY from the repo root .env (anon key only, never the service role key).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only (used by /api/pesa). Never expose to the browser, never prefix with NEXT_PUBLIC_.
# Value: SUPABASE_SERVICE_ROLE_KEY from the repo root .env. On Vercel mark it Sensitive.
SUPABASE_SERVICE_ROLE_KEY=
